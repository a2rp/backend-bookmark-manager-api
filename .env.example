# Server port
PORT=1206

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/backend_bookmark_manager_api

# Use a long random value with at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# The frontend origin allowed to send credentialed requests
CLIENT_ORIGIN=http://localhost:5173

# Use production to enable secure cookies over HTTPS
NODE_ENV=development
