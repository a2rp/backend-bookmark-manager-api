# Server port
PORT=1206

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/backend_bookmark_manager_api

# Generate a unique random secret of at least 32 characters before starting the API
JWT_SECRET=change_me_generate_a_random_secret_of_at_least_32_chars

# Comma-separated frontend origins allowed to send credentialed requests
CLIENT_ORIGIN=http://localhost:5173

# Use production to enable secure cookies over HTTPS
NODE_ENV=development
